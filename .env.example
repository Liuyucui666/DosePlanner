# 应用程序配置
APP_NAME="Dose Planner"
APP_VERSION="0.1.0"

# 数据库配置
DATABASE_URL="sqlite:///data/dose_planner.db"
# 如需使用PostgreSQL：
# DATABASE_URL="postgresql://user:password@localhost/dose_planner"

# 日志配置
LOG_LEVEL="INFO"
LOG_FILE="logs/dose_planner.log"

# 数据目录
DATA_DIR="./data"
SEEDS_DIR="${DATA_DIR}/seeds"
CT_IMAGES_DIR="${DATA_DIR}/ct_images"

# 计算配置
DEFAULT_GRID_RESOLUTION=1.0  # mm
DEFAULT_GRID_SIZE=256
USE_PARALLEL_PROCESSING=true
MAX_WORKERS=4

# 可视化配置
DEFAULT_COLORMAP="viridis"
SHOW_ISODOSE_LINES=true
ISODOSE_LEVELS="50,80,90,100"  # 百分比